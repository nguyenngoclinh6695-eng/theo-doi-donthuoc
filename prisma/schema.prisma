// Lược đồ database phòng khám.
// Quy ước: thời điểm lưu dạng timestamptz (UTC trong DB, hiển thị theo giờ Việt Nam);
// ngày sinh lưu dạng date (không có giờ, tránh lệch ngày do múi giờ).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DOCTOR
  NURSE
  RECEPTION
  ADMIN
  PHARMACIST // Dược sĩ
  TECHNICIAN // Kỹ thuật viên
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED // Đã hẹn, chưa đến
  ARRIVED // Bệnh nhân đã đến
  NO_SHOW // Vắng
  CANCELLED // Huỷ hẹn
}

enum PrescriptionStatus {
  DRAFT // Đang kê, còn sửa được
  FINALIZED // Đã chốt, không sửa nữa; chờ in và ký tay
  CANCELLED
}

/// Nhân viên dùng hệ thống.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  fullName           String
  role               UserRole
  isActive           Boolean   @default(true)
  /// Tài khoản mẫu do script seed tạo; seed chỉ xoá/tạo lại tài khoản mẫu, không đụng tới tài khoản thật.
  isSample           Boolean   @default(false)
  /// Mật khẩu đã băm bằng scrypt (không bao giờ lưu mật khẩu gốc). Null = chưa đặt, không đăng nhập được.
  passwordHash       String?
  /// Bắt đổi mật khẩu ở lần đăng nhập tới (tài khoản mới, hoặc vừa được quản trị đặt lại mật khẩu).
  mustChangePassword Boolean   @default(true)
  /// Đếm số lần nhập sai liên tiếp để tạm khoá, chống dò mật khẩu.
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  sessions             Session[]
  standardSources      StandardSource[] @relation("StandardSourceCreatedBy")
  standardSetsCreated  StandardSet[]    @relation("StandardSetCreatedBy")
  standardSetsApproved StandardSet[]    @relation("StandardSetApprovedBy")
  measurementsRecorded Measurement[]    @relation("MeasurementRecordedBy")
  appointmentsCreated  Appointment[]    @relation("AppointmentCreatedBy")
  visits               Visit[]          @relation("VisitDoctor")
  visitsStarted        Visit[]          @relation("VisitStartedBy")
  prescriptions        Prescription[]
  reminderCalls        ReminderCall[]
  auditLogs            AuditLog[]
}

/// Phiên đăng nhập. Trình duyệt chỉ giữ token ngẫu nhiên trong cookie; DB chỉ lưu bản băm SHA-256 của token,
/// nên dù lộ bảng này cũng không dùng được để đăng nhập.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  /// Hạn tuyệt đối của phiên.
  expiresAt  DateTime @db.Timestamptz(3)
  /// Lần hoạt động gần nhất, dùng để tự đăng xuất khi bỏ máy lâu.
  lastSeenAt DateTime @db.Timestamptz(3)
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Patient {
  id           String    @id @default(uuid()) @db.Uuid
  /// Mã bệnh nhân nội bộ, hiển thị trên giấy tờ. Cấp tự động từ sequence của PostgreSQL (không trùng kể cả khi hai máy tạo cùng lúc).
  code         String    @unique @default(dbgenerated("('BN-' || lpad((nextval('patient_code_seq'::regclass))::text, 6, '0'))"))
  fullName     String
  dateOfBirth  DateTime? @db.Date
  sex          Sex?
  phone        String?
  address      String?
  /// Số định danh cá nhân / CCCD (trường có trên mẫu đơn thuốc).
  idNumber     String?
  /// Số thẻ BHYT, nếu có.
  insuranceNo  String?
  /// Họ tên cha/mẹ hoặc người giám hộ – dùng khi kê đơn cho trẻ nhỏ.
  guardianName String?
  /// Ghi chú dị ứng do nhân viên ghi nhận (văn bản tự do, hệ thống không tự suy luận).
  allergyNote  String?
  /// Chuỗi tìm kiếm: họ tên bỏ dấu + mã + số điện thoại + CCCD, chữ thường. Ứng dụng tự cập nhật khi lưu hồ sơ.
  searchText   String    @default("")
  /// Đánh dấu dữ liệu mẫu, để xoá sạch trước khi dùng thật và để script seed không đụng tới dữ liệu thật.
  isSample     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  appointments  Appointment[]
  visits        Visit[]
  prescriptions Prescription[]
  reminderCalls ReminderCall[]
  measurements  Measurement[]

  @@index([fullName])
  @@index([phone])
  @@index([updatedAt])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @db.Uuid
  scheduledAt DateTime          @db.Timestamptz(3)
  /// Lý do tái khám do nhân viên ghi (văn bản hành chính, không phải chẩn đoán).
  reason      String
  status      AppointmentStatus @default(SCHEDULED)
  createdById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  visit         Visit?
  reminderCalls ReminderCall[]

  @@index([scheduledAt])
  @@index([patientId, scheduledAt])
}

enum VisitStatus {
  IN_PROGRESS // Đang khám
  COMPLETED // Đã kết thúc
}

/// Một lượt khám.
model Visit {
  id            String      @id @default(uuid()) @db.Uuid
  patientId     String      @db.Uuid
  /// Bác sĩ phụ trách; có thể trống khi điều dưỡng mở lượt khám để đo chỉ số trước.
  doctorId      String?     @db.Uuid
  startedById   String?     @db.Uuid
  /// Lượt khám phát sinh từ lịch hẹn nào (nếu có).
  appointmentId String?     @unique @db.Uuid
  visitedAt     DateTime    @db.Timestamptz(3)
  status        VisitStatus @default(COMPLETED)
  /// Lý do đến khám (hành chính, do nhân viên ghi).
  reason        String?
  /// Chẩn đoán do BÁC SĨ ghi – hệ thống không tự chẩn đoán.
  diagnosisText String?
  /// Ghi chép khám của bác sĩ.
  clinicalNote  String?
  completedAt   DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        User?          @relation("VisitDoctor", fields: [doctorId], references: [id])
  startedBy     User?          @relation("VisitStartedBy", fields: [startedById], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
  measurements  Measurement[]

  @@index([visitedAt])
  @@index([patientId, visitedAt])
}

/// Đơn thuốc. Bản nháp sửa được; đã chốt thì không sửa (muốn đổi phải huỷ và kê đơn mới).
model Prescription {
  id              String             @id @default(uuid()) @db.Uuid
  /// Số đơn nội bộ, cấp tự động từ sequence.
  code            String             @unique @default(dbgenerated("('DT-' || lpad((nextval('prescription_code_seq'::regclass))::text, 6, '0'))"))
  patientId       String             @db.Uuid
  doctorId        String             @db.Uuid
  visitId         String?            @db.Uuid
  status          PrescriptionStatus @default(DRAFT)
  finalizedAt     DateTime?          @db.Timestamptz(3)
  /// Đường dẫn file scan đơn đã có chữ ký tay; null = chưa tải lên.
  signedScanPath  String?
  scanUploadedAt  DateTime?          @db.Timestamptz(3)
  /// Chẩn đoán ghi trên đơn (do bác sĩ ghi).
  diagnosisText   String?
  /// Lời dặn của bác sĩ.
  advice          String?
  followUpDate    DateTime?          @db.Date
  /// Ảnh chụp thông tin bệnh nhân lúc chốt đơn – bản in luôn khớp với lúc chốt dù hồ sơ sửa sau này.
  patientSnapshot Json?
  cancelledAt     DateTime?          @db.Timestamptz(3)
  cancelReason    String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  patient Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  User               @relation(fields: [doctorId], references: [id])
  visit   Visit?             @relation(fields: [visitId], references: [id])
  items   PrescriptionItem[]

  @@index([status, scanUploadedAt])
}

/// Một dòng thuốc trong đơn. Lưu kèm tên/đơn vị thuốc lúc kê để đơn cũ không đổi khi danh mục sửa.
model PrescriptionItem {
  id                String @id @default(uuid()) @db.Uuid
  prescriptionId    String @db.Uuid
  drugId            String @db.Uuid
  drugName          String
  drugDosageForm    String
  unit              String
  quantity          Int
  /// Cách dùng do bác sĩ ghi (liều, số lần, thời điểm).
  dosageInstruction String
  durationDays      Int?
  sortOrder         Int    @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug         Drug         @relation(fields: [drugId], references: [id])
}

/// Mỗi lần nhân viên gọi nhắc bệnh nhân trễ hẹn.
model ReminderCall {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  appointmentId String?  @db.Uuid
  calledById    String   @db.Uuid
  calledAt      DateTime @default(now()) @db.Timestamptz(3)
  note          String?

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  calledBy    User         @relation(fields: [calledById], references: [id])

  @@index([appointmentId, calledAt])
}

/// Nhật ký thao tác. Chỉ thêm, không sửa/xoá.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  /// Mã hành động, vd. "reminder_call.create".
  action     String
  entityType String
  entityId   String?
  details    Json?
  at         DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([at])
}

// ───────────────────────── Danh mục thuốc ─────────────────────────

/// Nhóm thuốc phải kiểm soát đặc biệt (dùng mẫu đơn riêng). Hệ thống hiện chỉ hỗ trợ đơn thông thường,
/// nên thuốc khác NORMAL sẽ bị chặn khi kê (fail-closed).
enum DrugControl {
  NORMAL
  NARCOTIC // Gây nghiện
  PSYCHOTROPIC // Hướng thần
  PRECURSOR // Tiền chất
}

model Drug {
  id                String             @id @default(uuid()) @db.Uuid
  /// Tên hoạt chất (tên chung).
  activeIngredient  String
  /// Hàm lượng / nồng độ, vd. "500 mg".
  strength          String
  /// Dạng bào chế, vd. "Viên nén".
  dosageForm        String
  /// Đơn vị tính khi kê số lượng, vd. "viên".
  unit              String
  brandName         String?
  route             String?
  control           DrugControl        @default(NORMAL)
  isActive          Boolean            @default(true)
  note              String?
  /// Chuỗi tìm kiếm bỏ dấu (hoạt chất + tên thương mại).
  searchText        String             @default("")
  isSample          Boolean            @default(false)
  prescriptionItems PrescriptionItem[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@index([activeIngredient])
}

// ───────────────────────── Thư viện chuẩn ─────────────────────────
// Toàn bộ ngưỡng phân loại chỉ số nằm ở đây, do người có thẩm quyền nhập kèm nguồn văn bản.
// Code KHÔNG chứa ngưỡng nào.

/// Loại chỉ số đo được (huyết áp tâm thu, đường huyết...). Chỉ định nghĩa tên và đơn vị, không có ngưỡng.
model MeasurementType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  unit      String
  /// Số chữ số thập phân khi nhập/hiển thị.
  decimals  Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  standardSets StandardSet[]
  measurements Measurement[]
}

/// Văn bản chuyên môn làm căn cứ (quyết định, hướng dẫn, phác đồ).
model StandardSource {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  documentNumber String?
  issuer         String?
  issuedDate     DateTime? @db.Date
  url            String?
  note           String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  createdBy User          @relation("StandardSourceCreatedBy", fields: [createdById], references: [id])
  sets      StandardSet[]
}

enum StandardSetStatus {
  DRAFT // Đang soạn, chưa dùng để phân loại
  ACTIVE // Đã duyệt, đang áp dụng
  RETIRED // Ngừng áp dụng (giữ lại để tra cứu lịch sử)
}

/// Một phiên bản bộ ngưỡng cho một loại chỉ số, áp dụng cho một nhóm bệnh nhân.
model StandardSet {
  id                String            @id @default(uuid()) @db.Uuid
  measurementTypeId String            @db.Uuid
  sourceId          String            @db.Uuid
  version           String
  /// Mục/trang/bảng trong văn bản nguồn, để người khác đối chiếu.
  sourceSection     String?
  effectiveFrom     DateTime          @db.Date
  /// Phạm vi áp dụng; null = mọi giới / mọi tuổi. Tuổi: từ ageMinYears (gồm) đến dưới ageMaxYears.
  sexScope          Sex?
  ageMinYears       Int?
  ageMaxYears       Int?
  status            StandardSetStatus @default(DRAFT)
  note              String?
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  approvedById      String?           @db.Uuid
  approvedAt        DateTime?         @db.Timestamptz(3)
  retiredAt         DateTime?         @db.Timestamptz(3)

  measurementType MeasurementType @relation(fields: [measurementTypeId], references: [id])
  source          StandardSource  @relation(fields: [sourceId], references: [id])
  createdBy       User            @relation("StandardSetCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?           @relation("StandardSetApprovedBy", fields: [approvedById], references: [id])
  bands           StandardBand[]
  measurements    Measurement[]

  @@index([measurementTypeId, status])
}

enum BandTone {
  NORMAL
  ATTENTION
  ALERT
}

/// Một khoảng giá trị trong bộ ngưỡng. Nhãn ghi đúng như văn bản nguồn.
model StandardBand {
  id             String   @id @default(uuid()) @db.Uuid
  setId          String   @db.Uuid
  label          String
  lowerBound     Decimal? @db.Decimal(12, 3)
  lowerInclusive Boolean  @default(true)
  upperBound     Decimal? @db.Decimal(12, 3)
  upperInclusive Boolean  @default(false)
  tone           BandTone
  sortOrder      Int      @default(0)

  set StandardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Chỉ số đo trong lượt khám ─────────────────────────

model Measurement {
  id                  String   @id @default(uuid()) @db.Uuid
  visitId             String   @db.Uuid
  patientId           String   @db.Uuid
  measurementTypeId   String   @db.Uuid
  value               Decimal  @db.Decimal(12, 3)
  measuredAt          DateTime @db.Timestamptz(3)
  recordedById        String   @db.Uuid
  /// Kết quả phân loại lưu kèm lúc ghi (nhãn + bộ ngưỡng đã dùng), để sau này ngưỡng đổi vẫn biết lúc đó phân loại theo căn cứ nào.
  classificationLabel String?
  standardSetId       String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  visit           Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  measurementType MeasurementType @relation(fields: [measurementTypeId], references: [id])
  recordedBy      User            @relation("MeasurementRecordedBy", fields: [recordedById], references: [id])
  standardSet     StandardSet?    @relation(fields: [standardSetId], references: [id])

  @@index([patientId, measurementTypeId, measuredAt])
}
