# Sao chép thành file .env rồi điền mật khẩu thật của máy bạn. KHÔNG commit file .env.
# Mật khẩu tài khoản quản trị "postgres" (chỉ dùng khi tạo database/tài khoản lần đầu).
POSTGRES_SUPERUSER_PASSWORD=doi-mat-khau-nay
# Ứng dụng kết nối bằng tài khoản riêng phongkham_app, không dùng tài khoản postgres.
DATABASE_URL="postgresql://phongkham_app:doi-mat-khau-nay@localhost:5432/phongkham?schema=public"
# Mật khẩu chung cho các tài khoản MẪU do "npm run db:seed" tạo (ít nhất 10 ký tự). Chỉ dùng trên máy phát triển.
SEED_USER_PASSWORD=doi-mat-khau-nay
# Chỉ đặt "false" nếu buộc phải chạy production qua HTTP trong LAN (cookie đăng nhập sẽ không có cờ Secure).
# AUTH_COOKIE_SECURE=false
